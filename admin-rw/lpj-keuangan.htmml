<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="utf-8" />
    <title>LPJ Keuangan Resmi - RW 01</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="../assets/images/logo.svg">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="../assets/css/style.css">
</head>

<body class="lpj-body">

    <div class="container text-right mb-3 no-print" style="max-width: 960px;">
        <button onclick="window.print()" class="btn btn-success font-weight-bold" style="background: #1b7a3e; border-radius: 10px;">
            <i class="fa-solid fa-print mr-2"></i> Cetak / Download PDF
        </button>
    </div>

    <div class="lpj-container">
        <!-- HEADER -->
        <div class="lpj-header">
            <div class="d-flex align-items-center gap-3">
                <img src="../assets/images/logo.svg" height="50" alt="SiSatu Logo" onerror="this.src='https://ui-avatars.com/api/?name=RW+01&background=1b7a3e&color=fff'">
                <div class="lpj-title ml-3">
                    <h2>LAPORAN PERTANGGUNGJAWABAN (LPJ) KAS</h2>
                    <p>Rukun Warga 01 &bull; Periode November 2026</p>
                </div>
            </div>
            <div class="text-right">
                <span class="badge badge-success px-3 py-2" style="font-size: 13px; background: #1b7a3e;">RESMI & DIVERIFIKASI</span>
            </div>
        </div>

        <!-- RINGKASAN SALDO -->
        <div class="summary-box">
            <div class="row text-center">
                <div class="col-4 border-right">
                    <span class="text-muted font-weight-bold font-size-13">TOTAL PEMASUKAN</span>
                    <h4 class="font-weight-bold text-success mt-1">Rp 18.450.000</h4>
                </div>
                <div class="col-4 border-right">
                    <span class="text-muted font-weight-bold font-size-13">TOTAL PENGELUARAN</span>
                    <h4 class="font-weight-bold text-danger mt-1">Rp 4.200.000</h4>
                </div>
                <div class="col-4">
                    <span class="text-muted font-weight-bold font-size-13">SALDO KAS SAAT INI</span>
                    <h4 class="font-weight-bold text-dark mt-1">Rp 186.540.000</h4>
                </div>
            </div>
        </div>

        <!-- RINCIAN TRANSAKSI -->
        <h5 class="font-weight-bold mb-3">Rincian Transaksi Kas RW 01</h5>
        <table class="table-lpj">
            <thead>
                <tr>
                    <th>TANGGAL</th>
                    <th>POS KAS</th>
                    <th>KETERANGAN TRANSAKSI</th>
                    <th>JENIS</th>
                    <th class="text-right">NOMINAL (RP)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>02 Nov 2026</td>
                    <td>Kebersihan</td>
                    <td>Penerimaan Iuran Kebersihan RT 01 - RT 05</td>
                    <td><span class="badge badge-success">Masuk</span></td>
                    <td class="text-right font-weight-bold text-success">+ 6.500.000</td>
                </tr>
                <tr>
                    <td>01 Nov 2026</td>
                    <td>Kebersihan</td>
                    <td>Honor Petugas Kebersihan & Pengangkut Sampah</td>
                    <td><span class="badge badge-danger">Keluar</span></td>
                    <td class="text-right font-weight-bold text-danger">- 2.800.000</td>
                </tr>
                <tr>
                    <td>28 Okt 2026</td>
                    <td>Keamanan</td>
                    <td>Iuran Ronda & Pos Kamling RT 01 - RT 10</td>
                    <td><span class="badge badge-success">Masuk</span></td>
                    <td class="text-right font-weight-bold text-success">+ 8.200.000</td>
                </tr>
                <tr>
                    <td>25 Okt 2026</td>
                    <td>Pembangunan</td>
                    <td>Perbaikan Penerangan Jalan Utama RW 01</td>
                    <td><span class="badge badge-danger">Keluar</span></td>
                    <td class="text-right font-weight-bold text-danger">- 1.400.000</td>
                </tr>
            </tbody>
        </table>

        <!-- LEMBAR PENGESAHAN -->
        <div class="signature-row">
            <div class="signature-box">
                <p class="font-weight-bold mb-1">Bendahara RW 01</p>
                <div class="signature-space"></div>
                <p class="font-weight-bold mb-0">Ibu Endang</p>
            </div>
            <div class="signature-box">
                <p class="font-weight-bold mb-1">Ketua RW 01</p>
                <div class="signature-space"></div>
                <p class="font-weight-bold mb-0">Bpk. H. Supriyadi</p>
            </div>
        </div>
    </div>

</body>

</html>